{
  "name": "pirot-next",
  "version": "1.0.0",
  "private": true,
  "description": "Pirot Next cooperative management on Cloudflare",
  "homepage": "https://github.com/mertmr/pirot-next",
  "repository": {
    "type": "git",
    "url": "https://github.com/mertmr/pirot-next.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "backup:tenant": "bun scripts/backup-tenant.ts",
    "build": "vite build",
    "cf:typegen": "wrangler types",
    "deploy:production": "node scripts/deploy.mjs production",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "dev": "vite --host 127.0.0.1 --port 9070",
    "e2e:login": "e2e login openai",
    "format:check": "prettier --check src scripts tests *.ts *.json wrangler.jsonc",
    "lint": "eslint . --max-warnings=0",
    "local:seed": "node scripts/local-seed.mjs",
    "local:setup": "node scripts/local-setup.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 9070",
    "provision": "node scripts/provision.mjs",
    "smoke:staging": "bun scripts/smoke-staging.ts",
    "staging:prepare-admin": "node scripts/prepare-staging-admin.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:e2e": "e2e run --tag smoke",
    "test:e2e:agent": "e2e run --tag agentic",
    "test:migration": "python3 scripts/test-postgres-export.py",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "overrides": {
    "fast-xml-parser": "5.10.1",
    "immutable": "4.3.9",
    "react": "$react",
    "react-dom": "$react-dom",
    "shell-quote": "1.9.0"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@fortawesome/fontawesome-svg-core": "7.3.0",
    "@fortawesome/free-solid-svg-icons": "7.3.0",
    "@fortawesome/react-fontawesome": "3.4.0",
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "axios": "1.20.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "5.3.8",
    "dayjs": "1.11.21",
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.3",
    "fuse.js": "7.5.0",
    "jose": "^6.2.12",
    "jsonc-parser": "^3.3.1",
    "lossless-json": "^4.3.1",
    "path-browserify": "1.0.1",
    "react": "19.2.8",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.2.8",
    "react-hook-form": "7.81.0",
    "react-jhipster": "1.0.3",
    "react-redux": "9.3.0",
    "react-toastify": "11.1.0",
    "react-top-loading-bar": "3.0.2",
    "redux": "5.0.1",
    "tslib": "2.8.1",
    "wrangler": "^4.146.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.71",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@e2e-dev/web": "0.11.2",
    "@eslint-react/eslint-plugin": "5.13.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "ai": "^7.0.107",
    "autoprefixer": "10.5.2",
    "deepmerge": "4.3.1",
    "e2e": "0.16.0",
    "esbuild": "^0.28.2",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "miniflare": "^5.20261001.0-alpha",
    "prettier": "3.9.5",
    "prettier-plugin-packagejson": "3.0.2",
    "react-infinite-scroll-component": "7.2.1",
    "sass": "1.80.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.18.0"
  }
}
